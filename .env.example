# ===== Kichkintoy: sozlamalar namunasi. Nusxa: backend/.env (haqiqiy kalitlarni gitga yuklamang!) =====
ENV=production                      # development | production
APP_URL=https://kichkintoy-frontend.onrender.com
FRONTEND_URL=https://kichkintoy-frontend.onrender.com
BACKEND_URL=https://kichkintoy-backend.onrender.com

# --- Supabase PostgreSQL: Project Settings -> Database -> Connection string -> "Transaction pooler" (6543) ---
DATABASE_URL=postgresql://postgres.PROJECTREF:PAROL@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Maxfiy kalitlar (uzun tasodifiy): python -c "import secrets;print(secrets.token_urlsafe(48))" ---
SECRET_KEY=
JWT_SECRET=

# --- Cookie (frontend /api ni backendga proksi qiladi -> bir xil domen) ---
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
CORS_ORIGINS=                       # bo'sh = FRONTEND_URL

# --- Email: Google Apps Script veb-ilova (apps-script/Code.gs, DEPLOY.md 3-bo'lim) ---
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
APPS_SCRIPT_SECRET=
EMAIL_FROM_NAME=Kichkintoy
EMAIL_TOKEN_MINUTES=30
RESET_TOKEN_MINUTES=30

# --- Supabase Storage (Settings -> API -> service_role). Bucketlar: documents (PRIVATE), media (PUBLIC) ---
SUPABASE_URL=https://PROJECTREF.supabase.co
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET_PRIVATE=documents
STORAGE_BUCKET_PUBLIC=media
MAX_UPLOAD_MB=8

# --- SMS OTP (ixtiyoriy; Eskiz.uz). Bo'sh bo'lsa telefon OTP o'chiq va API 503 qaytaradi ---
SMS_PROVIDER=
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# --- Birinchi Super Admin (faqat birinchi ishga tushirishda yaratiladi; keyin parolni o'zgartiring va 2FA yoqing) ---
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# --- Keep-alive (Render bepul tarif): backendning o'z manzili + /health ---
SELF_PING_URL=https://kichkintoy-backend.onrender.com/health
SELF_PING_MINUTES=10

RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Frontend (Render Static/Web service env) ---
# BACKEND_URL (yuqoridagi) -> Next.js /api/* so'rovlarini shu yerga yo'naltiradi
# NEXT_PUBLIC_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=   (web push uchun, ixtiyoriy)
